// The packed page of an otherwise live app: everything History shows is
// generated by the server from the corpus as it stands; this is the part
// that never changes, pinned by its hash inside the pack.
style "page" padding="xl" gap="md"
style "title" size=20 weight="bold" color="text"
style "muted" color="text-muted" size=13
style "back" color="accent" size=13 underline=#false

column style="page" {
    sensitive tier=1
    text "History" style="title"
    text "The machine's memory: what this desktop showed, as it showed it — searchable, replayable, and honest about its holes."
    text "Recording is always on; sensitivity is classification, not exclusion. This viewer shows the routine tier only — sensitive tiers are read deliberately, with `rill history --tier`." style="muted"
    text "The same pages an agent reads: /history/context is the recent past as a diary, /history/data the raw tail. No screenshots, no OCR." style="muted"
    link "Back to the timeline" target="/history" style="back"
}
