// The one packed page in an otherwise live app. Everything the explorer
// shows is generated by the server as you browse; this is the part that is
// the same every time, so it ships inside the pack and is pinned by its
// hash. Reached from the sidebar.
//
// Spacing here names steps rather than pixels, which a *style* can do and a
// node cannot — node padding/gap are literals (plus "auto"), style padding/
// gap are the theme's vocabulary.
style "page" padding="xl" gap="md"
style "title" size=20 weight="bold" color="text"
style "muted" color="text-muted" size=13
style "back" color="accent" size=13 underline=#false

column style="page" {
    text "Files" style="title"
    text "Browse the served namespace — every path this device is allowed to fetch, and nothing it is not."
    text "Directories you see are the ones that lead somewhere for you. What the policy withholds is counted, never named — an unauthorized path answers NOT_FOUND rather than admitting it exists." style="muted"
    text "Writes are confined to one declared subtree. The policy answers reads only, so anything that changes the disk has to be bounded outside it." style="muted"
    link "Back to files" target="/files" style="back"
}
